# YouTube
YOUTUBE_API_KEY=
YOUTUBE_UPDATE_DESCRIPTION=false      # practice mode: log only, never call the API

# Transcription
TRANSCRIPT_METHOD=captions            # captions | whisper | auto (captions, fall back to whisper)
WHISPER_MODEL=small                   # tiny | base | small | medium | large-v3 | turbo
WHISPER_DEVICE=auto                   # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=int8

# LLM: pick a provider, then fill in that provider's key below
LLM_PROVIDER=anthropic                # anthropic | openai | gemini | groq | deepseek | openrouter | mistral | ollama | custom
LLM_MODEL=                            # empty = claude-opus-5-5 (anthropic only; required for other providers)
LLM_BASE_URL=                         # only for custom, or to override a provider's URL
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
LLM_API_KEY=                          # custom provider only (Ollama needs no key)

# Where the blog goes besides generated_blogs/ (always written)
DESTINATION=ghost                     # ghost | sanity | none; a CMS without keys below is skipped

# Ghost (optional: leave GHOST_ADMIN_API_KEY empty to only produce article.md)
GHOST_URL=http://localhost:2368
GHOST_ADMIN_API_KEY=                  # format id:secret
GHOST_CONTENT_API_KEY=
GHOST_AUTHOR_EMAIL=                   # staff user to credit (e.g. a placeholder "Test Author")
GHOST_PRIMARY_TAG=video-explainer
SITE_URL=                             # public blog base, e.g. https://example.com/blog (canonical URL); empty = none

# Sanity (DESTINATION=sanity; add the schema in cms/sanity/ to your Studio first)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=                     # Editor permissions
SANITY_API_VERSION=v2025-02-19
SANITY_STUDIO_URL=                    # e.g. http://localhost:3333, for links to the draft
SANITY_POST_TYPE=post
SANITY_FIELDS=                        # renames, e.g. content=body,coverImage=mainImage,seo=-

# GitHub (optional, raises rate limits)
GITHUB_TOKEN=

# Slack (optional)
SLACK_WEBHOOK_URL=

# Webhook server
WEBHOOK_SECRET=
